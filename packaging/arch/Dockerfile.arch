# syntax=docker/dockerfile:1
FROM archlinux:base-devel AS builder

ARG APP_NAME=qtranscribe

# Initialize pacman keyring and install build + runtime dependencies
RUN pacman-key --init && \
    pacman-key --populate archlinux && \
    pacman -Syu --noconfirm \
        cmake \
        ninja \
        gcc \
        pkgconf \
        wayland-protocols \
        desktop-file-utils \
        namcap \
        sudo \
        git \
        tar \
        gzip \
        qt6-base \
        qt6-declarative \
        qt6-multimedia \
        qt6-svg \
        qt6-wayland \
        qtkeychain-qt6 \
        libevdev \
        libcap \
        wayland \
        wl-clipboard \
        vulkan-headers \
        vulkan-icd-loader \
        shaderc \
        spirv-headers \
        hicolor-icon-theme && \
    pacman -Scc --noconfirm

# Create non-root builduser with passwordless sudo (required by makepkg)
RUN useradd -m -s /bin/bash builduser && \
    echo "builduser ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/builduser && \
    chmod 0440 /etc/sudoers.d/builduser

# Pre-clone whisper.cpp source in cached layer so CMake does not download it during every build
RUN git clone --depth 1 --branch v1.9.3 https://github.com/ggml-org/whisper.cpp.git /opt/whisper-src && \
    chown -R builduser:builduser /opt/whisper-src

WORKDIR /build

# Copy source tree and packaging templates
COPY --chown=builduser:builduser . /build/src-tree
COPY --chown=builduser:builduser packaging/arch/PKGBUILD /build/PKGBUILD
COPY --chown=builduser:builduser packaging/arch/qtranscribe.install /build/qtranscribe.install

RUN chown -R builduser:builduser /build

USER builduser
WORKDIR /build

ARG APP_VERSION=""
ARG APP_RELEASE=1

# Resolve version from canonical VERSION file if not overridden, create source archive, and build package
RUN set -eux; \
    if [ -z "${APP_VERSION}" ]; then \
        APP_VERSION=$(cat /build/src-tree/VERSION | tr -d '[:space:]'); \
    fi; \
    echo "Building Arch package for ${APP_NAME} version ${APP_VERSION} release ${APP_RELEASE}"; \
    mkdir -p /build/${APP_NAME}-${APP_VERSION}; \
    cp -a /build/src-tree/. /build/${APP_NAME}-${APP_VERSION}/; \
    tar \
        --exclude='.git' \
        --exclude='build*' \
        --exclude='dist' \
        -czf /build/${APP_NAME}-${APP_VERSION}.tar.gz \
        -C /build \
        ${APP_NAME}-${APP_VERSION}; \
    sed -i "s/^pkgver=.*/pkgver=${APP_VERSION}/" /build/PKGBUILD && \
    sed -i "s/^pkgrel=.*/pkgrel=${APP_RELEASE}/" /build/PKGBUILD && \
    sed -i "s|^source=.*|source=(\"${APP_NAME}-${APP_VERSION}.tar.gz\")|" /build/PKGBUILD && \
    sed -i "s|^sha256sums=.*|sha256sums=('SKIP')|" /build/PKGBUILD && \
    makepkg --noconfirm --nodeps

# ---------------------------------------------------------------------------
# Validation: Verify package metadata, namcap linting, pacman install, capabilities
# ---------------------------------------------------------------------------
USER root

RUN set -eux; \
    PKG_FILE=$(find /build -type f -name "${APP_NAME}-*.pkg.tar.zst" | head -n 1); \
    echo "============================================================"; \
    echo "Inspecting Arch package: ${PKG_FILE}"; \
    echo "============================================================"; \
    pacman -Qip "${PKG_FILE}"; \
    \
    echo "============================================================"; \
    echo "Inspecting package file list:"; \
    echo "============================================================"; \
    pacman -Qlp "${PKG_FILE}"; \
    \
    echo "============================================================"; \
    echo "Running Namcap package linter:"; \
    echo "============================================================"; \
    namcap /build/PKGBUILD || true; \
    namcap "${PKG_FILE}" || true; \
    \
    echo "============================================================"; \
    echo "Testing clean installation via pacman:"; \
    echo "============================================================"; \
    pacman -U --noconfirm "${PKG_FILE}"; \
    \
    echo "============================================================"; \
    echo "Validating installed binaries & capabilities:"; \
    echo "============================================================"; \
    test -x /usr/bin/qtranscribe; \
    test -x /usr/bin/keyinjectord; \
    test -f /usr/share/applications/io.github.qtranscribe.desktop; \
    desktop-file-validate /usr/share/applications/io.github.qtranscribe.desktop; \
    getcap /usr/bin/keyinjectord | grep -E 'cap_dac_override[+=]p'

# ---------------------------------------------------------------------------
# Export stage: Output .pkg.tar.zst packages to host
# ---------------------------------------------------------------------------
FROM scratch AS export

COPY --from=builder /build/*.pkg.tar.zst /
