# syntax=docker/dockerfile:1
ARG FEDORA_VERSION=44
FROM fedora:${FEDORA_VERSION} AS builder

ARG APP_NAME=qtranscribe

RUN dnf update -y && dnf install -y \
    rpm-build \
    rpmdevtools \
    gcc-c++ \
    cmake \
    ninja-build \
    desktop-file-utils \
    libappstream-glib \
    tar \
    gzip \
    file \
    libcap \
    \
    qt6-rpm-macros \
    qt6-qtbase-devel \
    qt6-qtdeclarative-devel \
    qt6-qtmultimedia-devel \
    qt6-qtsvg-devel \
    qt6-qtwayland \
    qtkeychain-qt6-devel \
    \
    libevdev-devel \
    libcap-devel \
    wayland-devel \
    wayland-protocols-devel \
    wl-clipboard \
    git \
    vulkan-loader-devel \
    vulkan-headers \
    glslc \
    spirv-headers-devel \
    && dnf clean all

# Pre-clone whisper.cpp source in cached layer so CMake does not download it during every build
RUN git clone --depth 1 --branch v1.9.3 https://github.com/ggml-org/whisper.cpp.git /opt/whisper-src

WORKDIR /build

# Copy source tree and spec file
COPY . /build/src-tree
COPY packaging/rpm/qtranscribe.spec /root/rpmbuild/SPECS/

ARG APP_VERSION=""
ARG APP_RELEASE=1

# Resolve version from canonical VERSION file if not overridden, create source archive, and build RPM
RUN set -eux; \
    if [ -z "${APP_VERSION}" ]; then \
        APP_VERSION=$(cat /build/src-tree/VERSION | tr -d '[:space:]'); \
    fi; \
    echo "Building RPM package for ${APP_NAME} version ${APP_VERSION} release ${APP_RELEASE}"; \
    mkdir -p /build/${APP_NAME}-${APP_VERSION}; \
    cp -a /build/src-tree/. /build/${APP_NAME}-${APP_VERSION}/; \
    mkdir -p /root/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}; \
    tar \
        --exclude='.git' \
        --exclude='build*' \
        --exclude='dist' \
        -czf /root/rpmbuild/SOURCES/${APP_NAME}-${APP_VERSION}.tar.gz \
        -C /build \
        ${APP_NAME}-${APP_VERSION}; \
    rpmbuild -bb \
        --define "version ${APP_VERSION}" \
        --define "release ${APP_RELEASE}" \
        /root/rpmbuild/SPECS/qtranscribe.spec

# ---------------------------------------------------------------------------
# Validation: Verify RPM metadata, dependencies, installation, and capabilities
# ---------------------------------------------------------------------------
RUN set -eux; \
    BIN_RPM=$(find /root/rpmbuild/RPMS -type f -name "${APP_NAME}-*.rpm" ! -name "*debug*" | head -n 1); \
    echo "============================================================"; \
    echo "Inspecting binary RPM: ${BIN_RPM}"; \
    echo "============================================================"; \
    rpm -qpil "${BIN_RPM}"; \
    \
    echo "============================================================"; \
    echo "Checking RPM dependencies:"; \
    echo "============================================================"; \
    rpm -qp --requires "${BIN_RPM}"; \
    \
    echo "============================================================"; \
    echo "Testing clean installation via RPM:"; \
    echo "============================================================"; \
    rpm -ivh "${BIN_RPM}"; \
    \
    echo "============================================================"; \
    echo "Validating installed binaries & capabilities:"; \
    echo "============================================================"; \
    test -x /usr/bin/qtranscribe; \
    test -x /usr/bin/keyinjectord; \
    test -f /usr/share/applications/io.github.qtranscribe.desktop; \
    desktop-file-validate /usr/share/applications/io.github.qtranscribe.desktop; \
    getcap /usr/bin/keyinjectord | grep -E 'cap_dac_override[+=]p'

# ---------------------------------------------------------------------------
# Export stage: Output release RPM package to host
# ---------------------------------------------------------------------------
FROM scratch AS export

COPY --from=builder /root/rpmbuild/RPMS/*/*.rpm /
